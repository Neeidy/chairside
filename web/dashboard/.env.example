# web/dashboard — the environment a deployment needs (HARDENING RM-1145 (f)). Names and FAKE placeholders only: the
# real values live in this machine's gitignored .env.local, never in git. Every name below is read by the code
# (lib/store.ts, lib/shopConfig.ts, lib/ownerAction.ts, lib/exportCsv.ts); nothing else is read.

# The store, as the READ-ONLY role salon_ro (store.ts refuses a role that can write). `pg` reads these itself.
PGHOST=REPLACE_WITH_DB_HOST
PGPORT=5432
PGDATABASE=salon
PGUSER=salon_ro
PGPASSWORD=REPLACE_WITH_SALON_RO_PASSWORD

# The shop's config as JSON (timezone and spend cap come from it); the same transport as web/site.
CLIENT_CONFIG_JSON=REPLACE_WITH_CLIENT_CONFIG_JSON

# The Release button: the engine's owner-action webhook, the shared HMAC secret, and the Access service token.
OWNER_ACTION_URL=REPLACE_WITH_OWNER_ACTION_WEBHOOK_URL
OWNER_HMAC_SECRET=REPLACE_WITH_OWNER_HMAC_SECRET
CF_OWNER_ACCESS_CLIENT_ID=REPLACE_WITH_ACCESS_CLIENT_ID
CF_OWNER_ACCESS_CLIENT_SECRET=REPLACE_WITH_ACCESS_CLIENT_SECRET

# CSV export links: 1 to show them; anything else and the export routes answer 404.
DASHBOARD_EXPORT_ENABLED=0
